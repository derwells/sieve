#!/usr/bin/env bash
# CLI twin of bin/sieve-mcp: loads TYPESAFE_API_KEY the same way, then runs sieve.ask.
set -euo pipefail

SIEVE_ENV_FILE="${SIEVE_ENV_FILE:-$HOME/.config/sieve/env}"
if [ -f "$SIEVE_ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$SIEVE_ENV_FILE"
  set +a
fi

exec uv run --directory "$(dirname "$(readlink -f "$0")")/.." python -m sieve.ask "$@"
